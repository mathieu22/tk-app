# Supabase → bouton "Connect" → onglet "ORMs" / "Prisma".
# Pooler transaction-mode (port 6543) : utilisé par l'application à l'exécution.
DATABASE_URL="postgresql://postgres.xxxxxxxx:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pooler session-mode (port 5432) : utilisé par la CLI Prisma (migrate, studio).
DIRECT_URL="postgresql://postgres.xxxxxxxx:password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Secret de signature des sessions et des QR codes (openssl rand -base64 32)
AUTH_SECRET="change-me"

# Protège la route de sauvegarde planifiée /api/cron/backup (voir vercel.json)
CRON_SECRET="change-me"
